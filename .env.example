WEBADB_ADDRESS=127.0.0.1:18087
# 可选：供脚本/API 客户端使用的兼容令牌，浏览器登录不需要
WEBADB_AUTH_TOKEN=
WEBADB_CORE_BINARY=./adbcontrol-core
WEBADB_DATA_DIR=./data
WEBADB_WEB_DIR=./web
WEBADB_COMPANION_APK=./companion.apk
WEBADB_COMPANION_VERSION_CODE=13
WEBADB_COMPANION_VERSION_NAME=0.13.0
# Companion 主动连接 Core 的独立 QUIC 监听；必须映射 UDP。
ADBCONTROL_COMPANION_LISTEN=0.0.0.0:45922
# 多网卡/容器部署时显式填写手机可访问的 Core 局域网 IP。
WEBADB_COMPANION_PUBLIC_HOST=
WEBADB_BEHIND_PROXY=false
